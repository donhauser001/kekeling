# ============================================
# 科科灵后端 API Dockerfile (开发环境)
# ============================================
# 支持热重载，通过 volume 映射源代码

FROM node:20-alpine

WORKDIR /app

# 安装必要工具
RUN apk add --no-cache openssl wget

# 安装 pnpm
RUN npm install -g pnpm

# 复制依赖文件和配置文件（利用 Docker 缓存）
COPY package.json pnpm-lock.yaml ./
COPY tsconfig.json nest-cli.json ./
COPY prisma ./prisma/

# 安装依赖
RUN pnpm install

# 生成 Prisma Client
RUN pnpm prisma generate

# 暴露端口
EXPOSE 3000

# 开发环境启动命令（使用 watch 模式）
CMD ["pnpm", "run", "dev"]
